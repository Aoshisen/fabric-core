{
  "name": "fabric-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --force",
    "demo:font:node": "node --experimental-strip-types src/demo/font.node.ts"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "await-to-js": "^3.0.0",
    "fabric": "^7.4.0",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.45"
  },
  "optionalDependencies": {
    "canvas": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vue-tsc": "^3.3.14"
  },
  "imports": {
    "#fabric": {
      "node": "fabric/node",
      "default": "fabric"
    },
    "#font-runtime": {
      "node": "./src/font/runtime.node.ts",
      "default": "./src/font/runtime.browser.ts"
    }
  }
}
